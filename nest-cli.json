{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "projects": {
    "main-api": {
      "type": "application",
      "root": "app/main-api",
      "entryFile": "main",
      "sourceRoot": "app/main-api/src",
      "compilerOptions": {
        "tsConfigPath": "app/main-api/tsconfig.app.json"
      }
    },
    "data-processing": {
      "type": "application",
      "root": "app/data-processing",
      "entryFile": "main",
      "sourceRoot": "app/data-processing/src",
      "compilerOptions": {
        "tsConfigPath": "app/data-processing/tsconfig.app.json"
      }
    }
  }
}
